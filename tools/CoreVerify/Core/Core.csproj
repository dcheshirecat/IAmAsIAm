<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles Assets/_Project/Scripts/Core outside Unity with Unity's constraints:
       .NET Standard 2.1, C# 9, no UnityEngine. Lets CI run tests without a Unity licence. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>IAmAsIAm.Core</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/_Project/Scripts/Core/**/*.cs" />
  </ItemGroup>
</Project>
