<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the vendored Ink compiler + runtime (extracted by check.sh into .ink-src)
       and the game's Core assembly, to validate the story outside Unity. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0618;CS0162;CS0168;CS0219;CS0414;CS0649;CS8632;CS0108;CS0114</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include=".ink-src/package/InkLibs/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../CoreVerify/Core/Core.csproj" />
  </ItemGroup>
</Project>
