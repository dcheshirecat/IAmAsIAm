{
  "sourceNote": "Each alter's own small practices (owner, 2026-11-12): their own faith or way of being, never Maya's Wiccan tools; they open as Maya gets to know each alter better (levelThresholds). Jacob's prayers are traditional Catholic prayers (the Sign of the Cross, the Our Father, the Hail Mary, the Glory Be, the Prayer to Saint Michael of Leo XIII); Nina's and Lily's are Quaker (waiting worship, holding someone in the Light, queries); Axel's is from Compline in the Book of Common Prayer ('Keep watch, dear Lord'). Heather's candle is her own faith and stays a mystery all game (owner): never explained.",
  "levelThresholds": [
    2,
    5,
    9
  ],
  "practices": [
    {
      "id": "jacob-sign",
      "memberId": "jacob",
      "name": "The Sign of the Cross",
      "level": 1,
      "grounding": 0.2,
      "steps": [
        {
          "phase": "Arrive",
          "kind": "breathe",
          "text": "Kneel, or just sit up straight. One breath.",
          "action": "Breathe",
          "seconds": 0
        },
        {
          "phase": "Prepare",
          "kind": "tap",
          "text": "In the name of the Father, and of the Son, and of the Holy Spirit.",
          "action": "Cross yourself",
          "seconds": 0
        },
        {
          "phase": "Moment",
          "kind": "hold",
          "text": "Our Father, who art in heaven... Say it all the way through, in your head.",
          "action": "Pray",
          "seconds": 7
        },
        {
          "phase": "Reflect",
          "kind": "choose",
          "text": "Who are you praying for?",
          "action": "",
          "seconds": 0,
          "options": [
            "Maya",
            "All of us",
            "Nobody. Just me."
          ]
        },
        {
          "phase": "Close",
          "kind": "tap",
          "text": "Amen.",
          "action": "Amen",
          "seconds": 0
        }
      ]
    },
    {
