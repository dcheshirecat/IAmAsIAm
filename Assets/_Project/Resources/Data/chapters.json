    {
      "id": "ch1-christianity",
      "number": 2,
      "title": "Chapter 1: Christianity (title to come)",
      "sabbat": "",
      "inkKnot": "ch1_christianity",
      "startingMemberId": "maya",
      "featuredMemberId": "",
      "setting": "Champaign-Urbana, Illinois: Maya's college years (2018 to 2020)",
      "skillFamily": "",
      "contentTags": [
        "religious-content",
        "time-loss",
        "involuntary-switch",
        "isolation",
        "breakup",
        "detransition",
        "pandemic"
      ],
      "summary": "Christianity, in college. Maya loses her junior year: it passes on a black screen, never explained. She comes back at the end of it to a life she doesn't recognise: a boyfriend, Mark, a kind, queer Episcopalian, and a body that has been living as a trans man. She detransitions and breaks up with Mark, who is left confused and hurt, and spends her senior year abandoned by everyone around her. She graduates alone, in the pandemic. Gracie, a young Catholic nun in training who volunteers at the campus ministry, is the guide. At a prayer service after graduation, Jacob comes forward.",
      "unlocksMemberId": "jacob"
    },
